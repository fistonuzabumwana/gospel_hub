<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- Card hugs verse content; extra widget cell area stays transparent -->
    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/widget_background_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Widget Background"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_background_border"
            android:contentDescription="Widget Border"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/widget_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Gospel Hub Logo"/>

                <TextView
                    android:id="@+id/widget_verse_ref"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="James 1:3"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="❮"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Previous Verse"/>

                <TextView
                    android:id="@+id/widget_btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="❯"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Next Verse"/>

            </LinearLayout>

            <TextView
                android:id="@+id/widget_verse_text_sans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="For he rent Israel..."
                android:textColor="#E2E8F0"
                android:textSize="13.5sp"
                android:lineSpacingMultiplier="1.15"
                android:ellipsize="end"
                android:maxLines="4"
                android:fontFamily="sans-serif"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/widget_verse_text_serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="For he rent Israel..."
                android:textColor="#E2E8F0"
                android:textSize="13.5sp"
                android:lineSpacingMultiplier="1.15"
                android:ellipsize="end"
                android:maxLines="4"
                android:fontFamily="serif"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/widget_verse_text_mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="For he rent Israel..."
                android:textColor="#E2E8F0"
                android:textSize="13.5sp"
                android:lineSpacingMultiplier="1.15"
                android:ellipsize="end"
                android:maxLines="4"
                android:fontFamily="monospace"
                android:visibility="gone"/>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
